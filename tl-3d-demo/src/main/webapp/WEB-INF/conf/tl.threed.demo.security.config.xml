<?xml version="1.0" encoding="utf-8" ?>

<!--
	Model-based access rights of the TL-3D demo (TopLogic 8.0.0-alpha7, Ticket #28).

	Role source: The roles "SecurityStructure.user" and "SecurityStructure.superuser" are assigned
	to the groups "user" and "superuser" on the security root "SecurityStructure#ROOT" (singleton
	rules from tl-element). The objects of the TL-3D model have no role of their own. All TL-3D
	types are implemented by StructuredElementWrapper subclasses, which ignore configured
	security parents (role parents). Therefore, inheritance rules pass the roles from the security
	root to all objects of the TL-3D types.
-->
<application config:interface="com.top_logic.basic.config.ApplicationConfig$Config"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<services>
		<config service-class="com.top_logic.tool.boundsec.manager.AccessManager">
			<instance>
				<role-rules>
					<rules>
						<!-- Scenes and their node trees (Scene, Assembly, Part, Text). -->
						<inheritance-rule id="tl3dRootRolesForScenePart"
							inherit="true"
							meta-element="tl.threed.demo:ScenePart"
							role="SecurityStructure.user,SecurityStructure.superuser"
						>
							<singleton module="SecurityStructure"/>
						</inheritance-rule>

						<!-- Asset catalogue and asset folders. -->
						<inheritance-rule id="tl3dRootRolesForAssetCollection"
							inherit="true"
							meta-element="tl.threed.demo:AssetCollection"
							role="SecurityStructure.user,SecurityStructure.superuser"
						>
							<singleton module="SecurityStructure"/>
						</inheritance-rule>

						<!-- Assets. -->
						<inheritance-rule id="tl3dRootRolesForAsset3D"
							inherit="true"
							meta-element="tl.threed.demo:Asset3D"
							role="SecurityStructure.user,SecurityStructure.superuser"
						>
							<singleton module="SecurityStructure"/>
						</inheritance-rule>

						<!-- Snapping and layout points of the assets. -->
						<inheritance-rule id="tl3dRootRolesForConnectionPoint"
							inherit="true"
							meta-element="tl.threed.demo:ConnectionPoint"
							role="SecurityStructure.user,SecurityStructure.superuser"
						>
							<singleton module="SecurityStructure"/>
						</inheritance-rule>
					</rules>
				</role-rules>
			</instance>
		</config>

		<config service-class="com.top_logic.model.security.SecurityConfigurationService">
			<instance>
				<security-config>
					<!-- Users and super users work with scenes and assets without restrictions. -->
					<module name="tl.threed.demo">
						<grant operation="Read"   roles="SecurityStructure.user, SecurityStructure.superuser" inherit="true"/>
						<grant operation="Write"  roles="SecurityStructure.user, SecurityStructure.superuser" inherit="true"/>
						<grant operation="Create" roles="SecurityStructure.user, SecurityStructure.superuser" inherit="true"/>
						<grant operation="Delete" roles="SecurityStructure.user, SecurityStructure.superuser" inherit="true"/>
					</module>
				</security-config>
			</instance>
		</config>
	</services>
</application>
